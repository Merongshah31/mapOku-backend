# =======================
# Supabase Configuration
# =======================
# Get these from: https://supabase.com/dashboard Ã¢â€ â€™ Your Project Ã¢â€ â€™ Settings Ã¢â€ â€™ API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-public-key-here

# =======================
# OpenRouteService Routing Engine
# =======================
ORS_BASE_URL=https://api.openrouteservice.org
ORS_API_KEY=your-openrouteservice-api-key-here
ORS_PROFILE=foot-walking
ORS_TIMEOUT_MS=10000
OBSTACLE_BUFFER_METERS=5
MAX_OBSTACLE_ZONES=25

# OpenWeatherMap
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
OPENWEATHER_API_KEY=your-openweathermap-api-key-here
OPENWEATHER_UNITS=metric
OPENWEATHER_LANG=ms
OPENWEATHER_TIMEOUT_MS=10000

# Google Vertex AI image validation
# Configure a model-enabled Google Cloud API key in Vercel/local .env.
VERTEX_AI_API_KEY=your-google-cloud-api-key-here
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
VERTEX_AI_BASE_URL=https://aiplatform.googleapis.com
VERTEX_AI_LOCATION=global
VERTEX_AI_MODEL=gemini-2.0-flash-001
VERTEX_AI_TIMEOUT_MS=15000
MODERATOR_API_KEY=your-private-moderator-key-here

# Google Cloud Speech-to-Text (voice navigation)
# Use Application Default Credentials locally; never commit this JSON file.
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-service-account.json
GOOGLE_SPEECH_LANGUAGE_CODE=ms-MY
GOOGLE_SPEECH_ENCODING=WEBM_OPUS
GOOGLE_SPEECH_MODEL=latest_short

# Google Cloud Speech-to-Text (voice navigation)
# Use Application Default Credentials locally; never commit this JSON file.
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-service-account.json
GOOGLE_SPEECH_LANGUAGE_CODE=ms-MY
GOOGLE_SPEECH_ENCODING=WEBM_OPUS
GOOGLE_SPEECH_MODEL=latest_short

# =======================
# Supabase Storage
# =======================
# Name of the storage bucket you create in Supabase Dashboard Ã¢â€ â€™ Storage
SUPABASE_STORAGE_BUCKET=obstacle-images

# =======================
# App Config
# =======================
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# =======================
# Obstacle Reputation
# =======================
# Number of downvotes required to auto-archive an obstacle
DOWNVOTE_ARCHIVE_THRESHOLD=3
