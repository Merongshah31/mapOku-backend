# =======================
# Supabase Configuration
# =======================
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-public-key-here

# =======================
# OSRM Routing Engine
# =======================
# Public OSRM demo server (free, no key required) — replace with self-hosted for production
OSRM_BASE_URL=https://router.project-osrm.org

# =======================
# Supabase Storage
# =======================
# Name of the storage bucket you create in Supabase Dashboard → Storage
SUPABASE_STORAGE_BUCKET=obstacle-images

# =======================
# App Config
# =======================
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# =======================
# Obstacle Reputation
# =======================
# Number of downvotes required to auto-archive an obstacle
DOWNVOTE_ARCHIVE_THRESHOLD=3
