# =======================
# Supabase Configuration
# =======================
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-public-key-here

# =======================
# OpenRouteService Routing Engine
# =======================
ORS_BASE_URL=https://api.openrouteservice.org
ORS_API_KEY=your-openrouteservice-api-key-here
ORS_PROFILE=foot-walking
ORS_TIMEOUT_MS=10000
OBSTACLE_BUFFER_METERS=5
MAX_OBSTACLE_ZONES=25

# OpenWeatherMap
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
OPENWEATHER_API_KEY=your-openweathermap-api-key-here
OPENWEATHER_UNITS=metric
OPENWEATHER_LANG=ms
OPENWEATHER_TIMEOUT_MS=10000

# =======================
# Supabase Storage
# =======================
# Name of the storage bucket you create in Supabase Dashboard → Storage
SUPABASE_STORAGE_BUCKET=obstacle-images

# =======================
# App Config
# =======================
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# =======================
# Obstacle Reputation
# =======================
# Number of downvotes required to auto-archive an obstacle
DOWNVOTE_ARCHIVE_THRESHOLD=3
