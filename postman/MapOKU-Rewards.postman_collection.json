{
  "info": {
    "name": "MapOKU Rewards",
    "description": "Rewards-only collection (no login).\n\n1. Run **Get Rewards**\n2. First item id is saved to `reward_item_id`\n3. Run **Redeem Reward**\n\nServer uses DEMO_USER_ID from .env for the points balance.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "reward_item_id", "value": "" }
  ],
  "item": [
    {
      "name": "1. Get Rewards",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json && json.data && json.data.items && json.data.items.length) {",
              "  pm.collectionVariables.set('reward_item_id', json.data.items[0].id);",
              "  console.log('reward_item_id saved:', json.data.items[0].id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/rewards",
        "description": "Returns points_balance and catalog items. No Authorization header."
      }
    },
    {
      "name": "2. Redeem Reward",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/v1/rewards/{{reward_item_id}}/redeem",
        "description": "Redeems reward_item_id against DEMO_USER_ID balance."
      }
    },
    {
      "name": "Health (optional)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health",
        "description": "Confirm server is up."
      }
    }
  ]
}
